NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dgap_os_db
DB_USER=replace_me
DB_PASSWORD=replace_me
# private writable directory OUTSIDE public/ and dist/. On Hostinger use an absolute, private path.
PRIVATE_UPLOAD_DIR=./private-uploads
# Required only before the first admin account exists. 32+ random characters.
SETUP_TOKEN=replace_with_a_long_random_secret_at_least_32_characters
